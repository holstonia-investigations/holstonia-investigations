 ---
layout: none
permalink: /search.json
---

[
{% assign docs = site.pages | where_exp: "p", "p.title" %}
{% for p in docs %}
  {% unless p.url contains ".json" or p.url contains ".xml" %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | absolute_url | jsonify }},
    "content": {{ p.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endunless %}
{% endfor %}
]
